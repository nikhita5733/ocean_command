function Waveline({ level = "moderate" }) {
  const amp = { calm: 4, moderate: 9, high: 16 }[level] ?? 9;
  const speed = { calm: 7, moderate: 4.5, high: 2.6 }[level] ?? 4.5;
  const color = level === "high" ? T.red : level === "moderate" ? T.orange : T.green;
  const path = `M0,40 Q 60,${40 - amp} 120,40 T 240,40 T 360,40 T 480,40 V80 H0 Z`;
  return (
    <div className="relative w-full h-14 overflow-hidden rounded-xl" style={{ background: "linear-gradient(180deg, #0B2A4A 0%, #051224 100%)", border: `1px solid ${T.line}` }}>
      <svg viewBox="0 0 480 80" preserveAspectRatio="none" className="absolute inset-0 w-full h-full">
