function Achievements({ cfg, stats, onBack }) {
  const list = cfg.achievements.map((a) => {
    let progress = 0;
    if (a.type === "days") progress = Math.min(stats.daysPlayed, a.target);
    else if (a.type === "good") progress = Math.min(stats.goodDecisions, a.target);
    else progress = stats.daysPlayed > 0 ? a.target : 0;
    return { ...a, progress };
  });
  return (
    <div className="flex flex-col h-full relative">
      <AmbientOcean />
      <div className="relative z-10"><TopBar title="ACHIEVEMENTS" onBack={onBack} /></div>
      <div className="flex-1 overflow-y-auto sw-scrollbar px-5 py-4 flex flex-col gap-2.5 relative z-10">
        {list.map((a, i) => {
          const Icon = a.icon;
          const done = a.progress >= a.target;
          return (
            <div key={a.title} className="rounded-2xl p-4 sw-card-hover sw-fade-up" style={{ background: T.card, border: `1px solid ${done ? T.lineStrong : T.line}`, animationDelay: `${i * 60}ms`, boxShadow: done ? `0 0 18px ${T.green}22` : "none" }}>
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style={{ background: done ? T.greenDim : T.panel, animation: done ? "seawisePulse 2.4s ease-in-out infinite" : "none" }}>
                  <Icon size={17} style={{ color: done ? T.green : T.inkFaint }} />
                </div>
                <div className="flex-1">
                  <p className="text-sm font-semibold" style={{ color: T.ink }}>{a.title}</p>
                  <p className="text-[11px]" style={{ color: T.inkFaint }}>{a.desc}</p>
                </div>
                {done ? (
                  <span className="text-[10px] font-bold px-2 py-1 rounded-lg" style={{ background: T.greenDim, color: T.green }}>DONE</span>
