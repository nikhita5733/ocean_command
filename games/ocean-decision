function OceanDecisionGame() {
  const [screen, setScreen] = useState("splash");
  const [prevScreen, setPrevScreen] = useState("dashboard");
  const [language, setLanguage] = useState("English");
  const [role, setRole] = useState(null);
  const [dayNumber, setDayNumber] = useState(1);
  const [playerState, setPlayerState] = useState(FISHERMAN_START);
  const [boatLevel, setBoatLevel] = useState(1);
  const [shopOwned, setShopOwned] = useState({ fuelTank: false, gps: false, safetyKit: false });
  const [settings, setSettings] = useState({ sound: true, music: true, vibration: true, notifications: true, language: "English" });
  const [stats, setStats] = useState({ daysPlayed: 0, totalScore: 0, bestScore: 0, goodDecisions: 0, longestStreak: 0 });

  const [dayPhase, setDayPhase] = useState("overview"); // overview | main | outcome | complete | challenge
  const [stepIndex, setStepIndex] = useState(0);
  const [showMap, setShowMap] = useState(false);
  const [pendingDecision, setPendingDecision] = useState(null);
  const [pendingEffects, setPendingEffects] = useState(null);
  const [dayHistory, setDayHistory] = useState([]);

  const cfg = ROLE_CONFIGS[role?.id] || ROLE_CONFIGS.fisherman;
  const step = cfg.dayFlow[stepIndex];
  const isLastStep = stepIndex === cfg.dayFlow.length - 1;

  function goto(id) { setPrevScreen(screen); setScreen(id); }

  function handlePickRole(r) {
    const c = ROLE_CONFIGS[r.id];
    setRole(r);
    setPlayerState(c.startState);
    setShopOwned(Object.fromEntries(c.shopItems.map((i) => [i.id, false])));
    setBoatLevel(1);
    setDayNumber(1);
    setStats({ daysPlayed: 0, totalScore: 0, bestScore: 0, goodDecisions: 0, longestStreak: 0 });
    goto("dashboard");
  }

  function handleStartDay() {
    setPlayerState((p) => ({
      ...p,
      safety: 100,
      fuel: clamp(100 + (shopOwned[cfg.fuelBonusItem.id] ? cfg.fuelBonusItem.amount : 0) + boatLevel * 5, 0, 100),
    }));
    setStepIndex(0);
    setDayPhase("overview");
    setDayHistory([]);
    setScreen("day");
  }

  function handleDecide(decision) {
    const nextState = applyEffects(playerState, decision.effects, decision.outcome);
    setPendingDecision(decision);
    setPendingEffects(decision.effects);
    setPlayerState(nextState);
    setDayHistory((h) => [...h, { decision }]);
    setDayPhase("outcome");
  }

  function goNextStep() {
    const next = stepIndex + 1;
    if (next >= cfg.dayFlow.length) {
      setDayPhase("complete");
    } else {
      setStepIndex(next);
      setDayPhase("main");
    }
  }

  function handleDayCompleteContinue() { setDayPhase("challenge"); }

  function handleChallengeNext() {
    const dayIncome = dayHistory.reduce((s, h) => s + Math.max(0, h.decision.effects.money), 0);
    const good = dayHistory.filter((h) => h.decision.outcome === "safe" || h.decision.outcome === "moderate").length;
    const total = Math.round((playerState.safety + playerState.fuel) / 2);
    setStats((s) => ({
      daysPlayed: s.daysPlayed + 1,
      totalScore: s.totalScore + total,
      bestScore: Math.max(s.bestScore, total),
      goodDecisions: s.goodDecisions + good,
      longestStreak: playerState.safety > 80 ? s.longestStreak + 1 : 0,
    }));
    setDayNumber((d) => d + 1);
    goto("dashboard");
  }

  function handleBuy(id, price) {
    if (playerState.money < price) return;
    setPlayerState((p) => ({ ...p, money: p.money - price }));
    setShopOwned((o) => ({ ...o, [id]: true }));
  }

  function handleUpgrade(cost) {
    if (playerState.money < cost) return;
    setPlayerState((p) => ({ ...p, money: p.money - cost }));
    setBoatLevel((l) => l + 1);
  }

  const dayIncomeSoFar = dayHistory.reduce((s, h) => s + Math.max(0, h.decision.effects.money), 0);
  const challengeMet = { safety: playerState.safety > 80, income: dayIncomeSoFar > cfg.challengeIncome };

  function renderDay() {
    if (dayPhase === "overview") return <DayOverview cfg={cfg} dayNumber={dayNumber} playerState={playerState} firstScenario={cfg.scenarios[0]} onContinue={() => setDayPhase("main")} />;
    if (dayPhase === "complete") return <DayComplete cfg={cfg} dayNumber={dayNumber} playerState={playerState} dayHistory={dayHistory} onContinue={handleDayCompleteContinue} />;
    if (dayPhase === "challenge") return <DailyChallenge cfg={cfg} met={challengeMet} onNext={handleChallengeNext} />;

    if (showMap) return <MapView cfg={cfg} scenario={step.scenario || cfg.scenarios[0]} onBack={() => setShowMap(false)} />;

    if (dayPhase === "outcome" && pendingDecision) {
      return <OutcomeScreen cfg={cfg} decision={pendingDecision} effects={pendingEffects} onContinue={goNextStep} isLastAction={isLastStep} />;
    }
    if (step.type === "decision") {
      return <DecisionCard cfg={cfg} scenario={step.scenario} playerState={playerState} onDecide={handleDecide} onMap={() => setShowMap(true)} />;
    }
    if (step.type === "event") {
      return <RandomEventCard event={cfg.randomEvent} onDecide={handleDecide} />;
    }
    if (step.type === "advisory") {
      return <AdvisoryPop advisory={cfg.advisoryPop} onCheck={goNextStep} />;
    }
    return null;
  }

  let body = null;
  if (screen === "splash") body = <Splash onPlay={() => goto("role")} language={language} setLanguage={setLanguage} />;
  else if (screen === "role") body = <RoleSelect onPick={handlePickRole} />;
  else if (screen === "dashboard") body = <Dashboard role={role} cfg={cfg} playerState={playerState} dayNumber={dayNumber} boatLevel={boatLevel} onStartDay={handleStartDay} onNav={goto} />;
  else if (screen === "shop") body = <Shop cfg={cfg} money={playerState.money} owned={shopOwned} onBuy={handleBuy} onNav={goto} />;
  else if (screen === "stats") body = <Stats stats={stats} onNav={goto} />;
  else if (screen === "profile") body = <Profile role={role} playerState={playerState} boatLevel={boatLevel} onNav={goto} />;
  else if (screen === "achievements") body = <Achievements cfg={cfg} stats={stats} onBack={() => goto("profile")} />;
  else if (screen === "boatupgrade") body = <BoatUpgrade cfg={cfg} boatLevel={boatLevel} money={playerState.money} onUpgrade={handleUpgrade} onBack={() => goto("profile")} />;
  else if (screen === "settings") body = <Settings settings={settings} setSettings={setSettings} onBack={() => goto(prevScreen === "dashboard" ? "dashboard" : "profile")} />;
  else if (screen === "howtoplay") body = <HowToPlay onBack={() => goto("profile")} />;
  else if (screen === "exitconfirm") body = <ExitConfirm onCancel={() => goto("profile")} onExit={() => { setScreen("splash"); setRole(null); }} />;
  else if (screen === "day") body = renderDay();

  return (
    <div className="w-screen h-screen flex items-center justify-center relative overflow-hidden" style={{ background: T.bgDeep, fontFamily: "ui-sans-serif, system-ui, sans-serif" }}>
      <GlobalStyle />
      <AmbientOcean />
      <a href="../index.html"
        className="sw-press"
        style={{
          position: "fixed", top: 16, left: 16, zIndex: 999,
          background: "rgba(9,26,46,0.85)", color: T.ink,
          padding: "9px 16px", borderRadius: 24,
          border: `1px solid ${T.lineStrong}`, textDecoration: "none",
          fontWeight: 700, fontSize: 12.5, letterSpacing: "0.03em",
          display: "flex", alignItems: "center", gap: 6, backdropFilter: "blur(6px)",
        }}>
        <ArrowLeft size={14} /> Home
      </a>
      <div
        className="relative z-10 flex flex-col overflow-hidden"
        style={{
          width: "min(480px, 94vw)",
          height: "min(900px, 94vh)",
          background: T.bg,
          borderRadius: 28,
          boxShadow: `0 0 0 1px ${T.lineStrong}, 0 40px 90px -20px rgba(0,0,0,0.7)`,
        }}
      >
        {body}
      </div>
    </div>
  );
}

const root = createRoot(document.getElementById("root"));
root.render(<OceanDecisionGame />);
</script>

</body>
</html>
