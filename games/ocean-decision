function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
function levelFromXp(xp) { return Math.floor(xp / 100) + 1; }

const REP_DELTA = { safe: 3, moderate: 1, risky: -3, dangerous: -8 };

function applyEffects(state, effects, outcome) {
  return {
    money: Math.max(0, state.money + effects.money),
    safety: clamp(state.safety + effects.safety, 0, 100),
    fuel: clamp(state.fuel + effects.fuel, 0, 100),
    catch: Math.max(0, state.catch + effects.catch),
    xp: state.xp + Math.max(0, effects.knowledge),
    reputation: clamp(state.reputation + (REP_DELTA[outcome] || 0), 0, 100),
  };
}

