let Trip={
  active:false, mission:null,
  boatX:PORT.x, boatY:PORT.y, heading:0, targetX:null, targetY:null,
  fuel:100, health:100, cargo:[], earnings:0,
  scoreCatch:0, scoreNav:0, scoreAwareness:0, scoreFuelEff:0, scoreSafety:300,
  safetyViolations:0, distanceTraveled:0, layersChecked:new Set(),
  storyFlags:{enteredHighQuality:false, respondedToStorm:false, stormEventFired:false, lowFuelWarned:false},
  stormBoost:false, activeAlert:false, wakeParticles:[],
};

function startTrip(mission){
  Trip={
    active:true, mission,
    boatX:PORT.x, boatY:PORT.y, heading:-Math.PI/2, targetX:null, targetY:null,
    fuel:mission.startFuel, health:100, cargo:[], earnings:0,
    scoreCatch:0, scoreNav:0, scoreAwareness:0, scoreFuelEff:0, scoreSafety:300,
    safetyViolations:0, distanceTraveled:0, layersChecked:new Set(['pfz']),
    storyFlags:{enteredHighQuality:false, respondedToStorm:false, stormEventFired:false, lowFuelWarned:false},
    stormBoost:false, activeAlert:false, wakeParticles:[], _leftPort:false,
  };
  zones=generateZones(WORLD_SEED = Date.now()%100000);
  weather.waveHeight=rand(0.8,1.6); weather.windSpeed=rand(10,20);
  cyclone = mission.forceWeatherEvent? {x:rand(0.5,0.9), y:rand(0.15,0.4), r:0.18, active:false, vx:-0.008, vy:0.004, fired:false} : null;
}

function distFrac(x1,y1,x2,y2){ return Math.hypot(x1-x2,y1-y2); }

function findZoneAt(x,y){
  for(const z of zones){ if(distFrac(x,y,z.x,z.y) <= z.radius) return z; }
  return null;
}

/* ---------------- Boat Update ---------------- */
function updateBoat(dt){
  const boat=currentBoat();
  const speed=0.09*boat.speed; // frac per second at full
  if(Trip.targetX!=null){
    const dx=Trip.targetX-Trip.boatX, dy=Trip.targetY-Trip.boatY;
    const d=Math.hypot(dx,dy);
    if(d<0.006){ Trip.boatX=Trip.targetX; Trip.boatY=Trip.targetY; Trip.targetX=null; }
    else{
      const desiredHeading=Math.atan2(dy,dx);
      let diff=desiredHeading-Trip.heading;
      while(diff>Math.PI) diff-=Math.PI*2; while(diff<-Math.PI) diff+=Math.PI*2;
      Trip.heading+=diff*Math.min(1,dt*4);
      const step=Math.min(d,speed*dt*(weather.waveHeight>2.2?0.6:1));
      const mx=Math.cos(Trip.heading)*step, my=Math.sin(Trip.heading)*step;
      Trip.boatX+=mx; Trip.boatY+=my;
      Trip.distanceTraveled += step;
      // fuel burn — larger fuel tanks burn a smaller % of capacity per km travelled
      const fuelPct = step*(60/boat.fuelCap*100);
      Trip.fuel = clamp(Trip.fuel - fuelPct, 0, 100*(boat.fuelCap/100));
      // wake particle
      if(Math.random()<0.6) Trip.wakeParticles.push({x:Trip.boatX,y:Trip.boatY,life:1});
    }
  }
  Trip.wakeParticles.forEach(p=>p.life-=dt*0.7);
  Trip.wakeParticles=Trip.wakeParticles.filter(p=>p.life>0);

  // storm damage if inside cyclone
  if(cyclone && cyclone.active){
    const d=distFrac(Trip.boatX,Trip.boatY,cyclone.x,cyclone.y);
    if(d<cyclone.r){
      Trip.health=clamp(Trip.health-dt*6,0,100);
      Trip.scoreSafety=clamp(Trip.scoreSafety-dt*20,0,300);
    }
  }
}

/* =========================================================
   RENDERING — Ocean canvas
   ========================================================= */
const canvas=document.getElementById('ocean-canvas');
const ctx=canvas.getContext('2d');
let W=0,H=0;
function resizeCanvas(){
  W=canvas.clientWidth; H=canvas.clientHeight;
  canvas.width=W*devicePixelRatio; canvas.height=H*devicePixelRatio;
  ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
}
window.addEventListener('resize',resizeCanvas);

let activeLayer='pfz';
let animT=0;

function drawOcean(dt){
  animT+=dt;
  // sky/water gradient responds to weather.condition
  let top='#0a3352', bottom='#04667a';
  if(weather.condition==='Storm/Cyclone Warning'){ top='#151c26'; bottom='#233144'; }
  else if(weather.condition==='Strong Wind'||weather.condition==='Rough Sea'){ top='#123049'; bottom='#0c4a5e'; }
  else if(weather.condition==='Cloudy'||weather.condition==='Windy'){ top='#0e3a58'; bottom='#0a5a72'; }
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,top); g.addColorStop(1,bottom);
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);

  // wave line texture
  ctx.save();
  ctx.globalAlpha=0.16;
  const waveAmp=6+weather.waveHeight*4;
  for(let i=0;i<7;i++){
    ctx.beginPath();
    const yBase=H*(0.12+i*0.13);
    for(let x=0;x<=W;x+=14){
      const y=yBase+Math.sin(x*0.02+animT*(0.6+weather.waveHeight*0.15)+i)*waveAmp*Math.sin(i*1.3+animT*0.1);
      x===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    }
    ctx.strokeStyle='#bdeeff'; ctx.lineWidth=1.4; ctx.stroke();
  }
  ctx.restore();

  // cyclone visualization
  if(cyclone && (cyclone.active||activeLayer==='hazard')){
    const cx=cyclone.x*W, cy=cyclone.y*H, r=cyclone.r*Math.min(W,H);
    ctx.save();
    for(let i=0;i<3;i++){
      ctx.beginPath();
      ctx.strokeStyle=`rgba(255,90,90,${0.5-i*0.14})`;
      ctx.lineWidth=3;
      const rot=animT*(1.2+i*0.4);
      ctx.arc(cx,cy,r*(0.4+i*0.28),rot,rot+Math.PI*1.4);
      ctx.stroke();
    }
    ctx.fillStyle='rgba(255,90,90,0.06)';
    ctx.beginPath(); ctx.arc(cx,cy,r,0,7); ctx.fill();
    ctx.font='22px sans-serif'; ctx.textAlign='center';
    ctx.fillStyle='#fff'; ctx.fillText('🌀',cx,cy+8);
    ctx.restore();
  }

  // layer overlays
  drawLayer();

  // port
  drawPort();

  // zones (PFZ always visible as subtle outline; full glow when pfz layer active)
  zones.forEach(z=>drawZone(z));

  // boat
  drawBoat();

  // weather particles (rain/wind streaks)
  drawWeatherFX(dt);
}

function drawPort(){
  const x=PORT.x*W, y=PORT.y*H;
  ctx.save();
  ctx.fillStyle='rgba(255,255,255,0.08)';
  ctx.beginPath(); ctx.arc(x,y,26,0,7); ctx.fill();
  ctx.font='26px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.fillText('⚓',x,y);
  ctx.fillStyle='#eaf6ff'; ctx.font='600 11px Inter, sans-serif';
  ctx.fillText('PORT',x,y+30);
  ctx.restore();
}

function drawZone(z){
  const x=z.x*W, y=z.y*H, r=z.radius*Math.min(W,H);
  const col=zoneColor(z.quality);
  ctx.save();
  const pulse=0.75+0.25*Math.sin(animT*1.6+z.x*10);
  if(activeLayer==='pfz'){
    const grad=ctx.createRadialGradient(x,y,r*0.1,x,y,r);
    grad.addColorStop(0,`rgba(${col.fill},${0.32*pulse})`);
    grad.addColorStop(1,`rgba(${col.fill},0)`);
    ctx.fillStyle=grad; ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.fill();
    ctx.strokeStyle=col.ring; ctx.lineWidth=2; ctx.globalAlpha=0.8;
    ctx.beginPath(); ctx.arc(x,y,r*pulse,0,7); ctx.stroke();
    ctx.globalAlpha=1;
    ctx.font='700 11px Rajdhani, sans-serif'; ctx.fillStyle='#fff'; ctx.textAlign='center';
    ctx.fillText(starString(z.quality), x, y-r-8);
  } else {
    ctx.strokeStyle=`rgba(${col.fill},0.35)`; ctx.lineWidth=1.4;
    ctx.setLineDash([4,4]);
    ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.stroke();
    ctx.setLineDash([]);
  }
  ctx.restore();
}

function drawLayer(){
  if(activeLayer==='wave'){
    ctx.save(); ctx.globalAlpha=0.5;
    for(let i=0;i<10;i++){
      for(let j=0;j<6;j++){
        const x=W*(i+0.5)/10, y=H*(j+0.5)/6;
        const v=(smoothNoise(x*0.01,y*0.01,()=>WORLD_SEED%97/97)+1)/2 * weather.waveHeight;
        const c = v>1.6? '255,77,94': v>1.0? '255,159,67':'46,230,166';
        ctx.fillStyle=`rgba(${c},0.10)`;
        ctx.beginPath(); ctx.arc(x,y,26,0,7); ctx.fill();
      }
    }
    ctx.restore();
  } else if(activeLayer==='wind'){
    ctx.save(); ctx.strokeStyle='rgba(200,235,255,0.35)'; ctx.lineWidth=1.4;
    const dirRad = {'N':-Math.PI/2,'NE':-Math.PI/4,'E':0,'SE':Math.PI/4,'S':Math.PI/2,'SW':3*Math.PI/4,'W':Math.PI,'NW':-3*Math.PI/4}[weather.windDir]||0;
    for(let i=0;i<9;i++)for(let j=0;j<6;j++){
      const x=W*(i+0.5)/9, y=H*(j+0.5)/6;
      const len=10+weather.windSpeed*0.4;
      const dx=Math.cos(dirRad)*len, dy=Math.sin(dirRad)*len;
      ctx.beginPath(); ctx.moveTo(x-dx/2,y-dy/2); ctx.lineTo(x+dx/2,y+dy/2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x+dx/2,y+dy/2); ctx.lineTo(x+dx/2-dx*0.3+dy*0.2,y+dy/2-dy*0.3-dx*0.2); ctx.stroke();
    }
    ctx.restore();
  } else if(activeLayer==='temp'){
    ctx.save(); ctx.globalAlpha=0.35;
    const grad=ctx.createLinearGradient(0,0,W,H);
    grad.addColorStop(0,'rgba(255,159,67,0.25)');
    grad.addColorStop(0.5,'rgba(255,217,61,0.15)');
    grad.addColorStop(1,'rgba(31,209,255,0.2)');
    ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);
    ctx.restore();
  } else if(activeLayer==='hazard'){
    ctx.save(); ctx.globalAlpha=0.25;
    ctx.fillStyle= weather.cycloneRisk==='HIGH'?'rgba(255,77,94,0.25)':weather.cycloneRisk==='MEDIUM'?'rgba(255,159,67,0.18)':'rgba(46,230,166,0.08)';
    ctx.fillRect(0,0,W,H);
    ctx.restore();
  }
}

function drawBoat(){
  const x=Trip.boatX*W, y=Trip.boatY*H;
  // wake
  Trip.wakeParticles.forEach(p=>{
    ctx.save(); ctx.globalAlpha=p.life*0.4; ctx.fillStyle='#bdeeff';
    ctx.beginPath(); ctx.arc(p.x*W,p.y*H,3+ (1-p.life)*4,0,7); ctx.fill(); ctx.restore();
  });
  ctx.save();
  ctx.translate(x,y);
  const bob=Math.sin(animT*3)*2;
  ctx.translate(0,bob);
  ctx.rotate(Trip.heading+Math.PI/2);
  // hull
  ctx.fillStyle='#0d2740'; ctx.strokeStyle='#1fd1ff'; ctx.lineWidth=1.6;
  ctx.beginPath();
  ctx.moveTo(0,-18); ctx.lineTo(9,10); ctx.quadraticCurveTo(0,18,-9,10); ctx.closePath();
  ctx.fill(); ctx.stroke();
  ctx.fillStyle='#e8f1f2'; ctx.beginPath(); ctx.arc(0,-2,4,0,7); ctx.fill();
  ctx.restore();
  // health-low glow ring
  if(Trip.health<40){
    ctx.save(); ctx.strokeStyle='rgba(255,77,94,0.6)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(x,y,22+Math.sin(animT*8)*3,0,7); ctx.stroke(); ctx.restore();
  }
}

let rainDrops=[];
function drawWeatherFX(dt){
  const isRain = weather.condition==='Storm/Cyclone Warning'||weather.condition==='Strong Wind'||weather.condition==='Rough Sea';
  if(isRain){
    while(rainDrops.length<90) rainDrops.push({x:Math.random()*W,y:Math.random()*H,l:rand(8,20),s:rand(6,12)});
    ctx.save(); ctx.strokeStyle='rgba(200,230,255,0.35)'; ctx.lineWidth=1;
    rainDrops.forEach(d=>{
      d.y+=d.s; d.x-=d.s*0.3;
      if(d.y>H){d.y=-10;d.x=Math.random()*W;}
      ctx.beginPath(); ctx.moveTo(d.x,d.y); ctx.lineTo(d.x-4,d.y+d.l); ctx.stroke();
    });
    ctx.restore();
  } else { rainDrops.length=Math.max(0,rainDrops.length-4); }
}

