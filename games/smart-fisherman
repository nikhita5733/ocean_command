const sonarCanvas=$('#sonar-canvas'); const sctx=sonarCanvas.getContext('2d');
let sonarBlips=[]; let sonarAngle=0; let sonarRAF=null;
$('#btn-sonar').addEventListener('click',()=>{
  if(!Trip.active) return;
  Audio1.click();
  const z=findZoneAt(Trip.boatX,Trip.boatY);
  const density = z? z.density:'LOW';
  const depth = z? z.depth: Math.round(rand(15,90));
  $('#sonar-depth').textContent=depth+'m';
  $('#sonar-density').textContent=density;
  const schoolSize = density==='HIGH'?'LARGE':density==='MEDIUM'?'MEDIUM':'SMALL';
  $('#sonar-school').textContent=schoolSize;
  const count = density==='HIGH'? 7: density==='MEDIUM'? 4:2;
  sonarBlips=[];
  for(let i=0;i<count;i++){
    sonarBlips.push({a:Math.random()*Math.PI*2, r:rand(0.25,0.9), size:rand(3,7)+(density==='HIGH'?3:0)});
  }
  openModal('modal-sonar');
  Audio1.ping();
  startSonarLoop();
});
document.getElementById('modal-sonar').addEventListener('click',(e)=>{ if(e.target.dataset.close||e.target===document.getElementById('modal-sonar')){ stopSonarLoop(); }});
function startSonarLoop(){
  stopSonarLoop();
  let last=performance.now();
  function loop(t){
    const dt=(t-last)/1000; last=t;
    sonarAngle+=dt*1.4;
    drawSonar();
    sonarRAF=requestAnimationFrame(loop);
  }
  sonarRAF=requestAnimationFrame(loop);
}
function stopSonarLoop(){ if(sonarRAF) cancelAnimationFrame(sonarRAF); sonarRAF=null; }
function drawSonar(){
  const cx=160,cy=160,R=150;
  sctx.clearRect(0,0,320,320);
  sctx.save();
  sctx.strokeStyle='rgba(31,209,255,0.25)'; sctx.lineWidth=1;
  for(let r=R/4;r<=R;r+=R/4){ sctx.beginPath(); sctx.arc(cx,cy,r,0,7); sctx.stroke(); }
  sctx.beginPath(); sctx.moveTo(cx-R,cy); sctx.lineTo(cx+R,cy); sctx.moveTo(cx,cy-R); sctx.lineTo(cx,cy+R); sctx.stroke();
  // sweep
  const grad=sctx.createConicGradient? sctx.createConicGradient(sonarAngle,cx,cy): null;
  sctx.save();
  sctx.beginPath(); sctx.moveTo(cx,cy);
  sctx.arc(cx,cy,R,sonarAngle-0.5,sonarAngle);
  sctx.closePath();
  sctx.fillStyle='rgba(31,209,255,0.25)'; sctx.fill();
  sctx.restore();
  // blips
  sonarBlips.forEach(b=>{
    const bx=cx+Math.cos(b.a)*b.r*R, by=cy+Math.sin(b.a)*b.r*R;
    const diff=Math.abs(((sonarAngle - b.a + Math.PI*3)%(Math.PI*2))-Math.PI);
    const lit = diff<0.6;
    sctx.beginPath(); sctx.arc(bx,by,b.size,0,7);
    sctx.fillStyle= lit? '#2ee6a6':'rgba(46,230,166,0.35)';
    sctx.shadowColor='#2ee6a6'; sctx.shadowBlur= lit? 14:0;
    sctx.fill();
  });
  sctx.restore();
}

