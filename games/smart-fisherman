async function saveProfile(){ await Store.save('profile',Profile); }

function currentBoat(){
  const base=BOATS.find(b=>b.id===Profile.boatId)||BOATS[0];
  const boat={...base};
  Profile.ownedUpgrades.forEach(uid=>{
    const u=UPGRADES.find(x=>x.id===uid); if(!u) return;
    boat[u.stat]=boat[u.stat]*(1+u.amt);
  });
  return boat;
}

/* ---------------- Ocean World Generation ---------------- */
// world coords are fractions 0..1 of canvas; PORT fixed near bottom-left
const PORT={x:0.12,y:0.85};
let WORLD_SEED=Date.now()%100000;
let zones=[];
let weather={ condition:'Clear', waveHeight:1.0, windSpeed:12, windDir:'NE', seaTemp:28.0, cycloneRisk:'LOW', time:0 };
let cyclone=null; // {x,y,r, active}

function generateZones(seed){
  const rng=mulberry32(seed);
  const list=[];
  const n=6;
  for(let i=0;i<n;i++){
    const x=0.28+rng()*0.62;
    const y=0.12+rng()*0.68;
    const qualityRoll=rng();
    let quality;
    if(qualityRoll>0.85) quality=5; else if(qualityRoll>0.62) quality=4; else if(qualityRoll>0.38) quality=3; else if(qualityRoll>0.15) quality=2; else quality=1;
    const fishProbability=clamp(Math.round(quality*17+rng()*10),12,97);
    list.push({
      id:'zone_'+i, x, y, radius:0.055+quality*0.006+rng()*0.01,
      quality, fishProbability,
      density: quality>=4?'HIGH':quality>=2?'MEDIUM':'LOW',
      depth: Math.round(20+rng()*70),
      dominantFish: quality>=4? 'tuna': quality>=3? 'pomfret': quality>=2? 'mackerel':'sardine',
    });
  }
  return list;
}

function zoneColor(q){
  if(q>=5) return {fill:'46,230,166', ring:'#2ee6a6'};
  if(q>=4) return {fill:'120,222,120', ring:'#7be07a'};
  if(q>=3) return {fill:'255,217,61', ring:'#ffd93d'};
  if(q>=2) return {fill:'255,159,67', ring:'#ff9f43'};
  return {fill:'255,77,94', ring:'#ff4d5e'};
}
function starString(q){ return '★'.repeat(q)+'☆'.repeat(5-q); }

function updateWeather(dt){
  weather.time+=dt;
  // slow drift
  weather.waveHeight=clamp(weather.waveHeight + Math.sin(weather.time*0.05)*0.002 + (Trip.active&&Trip.stormBoost?0.01:0), 0.4, 4.5);
  weather.windSpeed=clamp(weather.windSpeed + Math.sin(weather.time*0.03+1)*0.03 + (Trip.active&&Trip.stormBoost?0.15:0), 4, 70);
  weather.seaTemp=clamp(27+Math.sin(weather.time*0.01)*1.5,24,31);
  if(weather.waveHeight>2.6||weather.windSpeed>38) weather.condition= (weather.waveHeight>3.4?'Storm/Cyclone Warning':'Strong Wind');
  else if(weather.waveHeight>1.8) weather.condition='Rough Sea';
  else if(weather.windSpeed>22) weather.condition='Windy';
  else weather.condition = Math.sin(weather.time*0.008)>0.3? 'Cloudy':'Clear';
  weather.cycloneRisk = weather.waveHeight>3.2? 'HIGH': weather.waveHeight>2.2? 'MEDIUM':'LOW';

  if(cyclone && cyclone.active){
    cyclone.x+=cyclone.vx*dt; cyclone.y+=cyclone.vy*dt;
    if(cyclone.x<0.15||cyclone.x>0.95) cyclone.vx*=-1;
    if(cyclone.y<0.1||cyclone.y>0.9) cyclone.vy*=-1;
  }
}

