<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Smart Fisherman — Ocean Intelligence Game</title>
<style>
@font-face{font-family:'sys';src:local('Arial');}
:root{
  --navy-deep:#050e1a;
  --navy:#0a1f33;
  --navy-panel:#0d2740;
  --ocean-blue:#0f4c75;
  --cyan:#1fd1ff;
  --turquoise:#2ec4b6;
  --pfz-green:#2ee6a6;
  --pfz-yellow:#ffd93d;
  --pfz-orange:#ff9f43;
  --pfz-red:#ff4d5e;
  --amber:#ffb238;
  --danger:#ff4d5e;
  --ink:#eaf6ff;
  --ink-dim:#9db4c9;
  --glass-bg:rgba(13,39,64,0.55);
  --glass-border:rgba(160,220,255,0.14);
  --radius:16px;
  --font-display:'Rajdhani','Segoe UI',sans-serif;
  --font-body:'Inter','Segoe UI',sans-serif;
}
@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap');
*{box-sizing:border-box;margin:0;padding:0;}
html,body{
  width:100%;height:100%;overflow:hidden;
  background:var(--navy-deep);
  color:var(--ink);
  font-family:var(--font-body);
  -webkit-tap-highlight-color:transparent;
  user-select:none;
}
#app{position:relative;width:100vw;height:100vh;overflow:hidden;}
.screen{
  position:absolute;inset:0;
  display:none;
  flex-direction:column;
  animation:fadeIn .5s ease;
}
.screen.active{display:flex;}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* ---------- Buttons ---------- */
.btn{
  font-family:var(--font-display);
  font-weight:700;
  letter-spacing:.04em;
  text-transform:uppercase;
  border:1px solid var(--glass-border);
  background:linear-gradient(180deg, rgba(31,209,255,0.16), rgba(31,209,255,0.04));
  color:var(--ink);
  padding:14px 30px;
  border-radius:10px;
  cursor:pointer;
  font-size:15px;
  backdrop-filter:blur(6px);
  transition:transform .15s ease, box-shadow .25s ease, background .25s ease, border-color .25s ease;
  position:relative;
  overflow:hidden;
}
.btn::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(120deg, transparent 40%, rgba(255,255,255,.25) 50%, transparent 60%);
  transform:translateX(-120%);
  transition:transform .6s ease;
}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(31,209,255,.25);border-color:var(--cyan);}
.btn:hover::after{transform:translateX(120%);}
.btn:active{transform:translateY(0px) scale(.98);}
.btn-primary{
  background:linear-gradient(180deg, #26e0c9, #0fa3a3);
  border-color:transparent;color:#04201d;box-shadow:0 8px 30px rgba(38,224,201,.35);
}
.btn-primary:hover{box-shadow:0 10px 36px rgba(38,224,201,.5);}
.btn-ghost{background:transparent;}
.btn-danger{background:linear-gradient(180deg,#ff6b6b,#e63946);border-color:transparent;color:#2a0a0d;}
.btn-sm{padding:8px 16px;font-size:12px;border-radius:8px;}
.btn:disabled{opacity:.35;cursor:not-allowed;transform:none;box-shadow:none;}
.icon-btn{
  width:52px;height:52px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  background:var(--glass-bg);border:1px solid var(--glass-border);
  font-size:22px;cursor:pointer;transition:all .2s ease;color:var(--ink);
  backdrop-filter:blur(8px);
}
.icon-btn:hover{border-color:var(--cyan);background:rgba(31,209,255,.12);transform:translateY(-2px);}
.icon-btn.active{border-color:var(--cyan);background:rgba(31,209,255,.22);box-shadow:0 0 18px rgba(31,209,255,.35);}

/* ---------- Glass panel ---------- */
.panel{
  background:var(--glass-bg);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  backdrop-filter:blur(14px) saturate(140%);
  box-shadow:0 10px 40px rgba(0,0,0,.35);
}

/* ---------- Scrollbars ---------- */
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-thumb{background:rgba(160,220,255,.25);border-radius:8px;}
::-webkit-scrollbar-track{background:transparent;}

/* ================= LANDING ================= */
#screen-landing{justify-content:center;align-items:center;}
#landing-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;}
.landing-vignette{position:absolute;inset:0;background:radial-gradient(ellipse at center, transparent 30%, rgba(2,8,16,.55) 100%);z-index:1;pointer-events:none;}
.landing-content{position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;align-items:center;gap:26px;padding:20px;}
.game-title{
  font-family:var(--font-display);
  font-weight:700;
  font-size:clamp(42px,9vw,96px);
  letter-spacing:.06em;
  background:linear-gradient(180deg,#fff 10%, #bdeeff 55%, #1fd1ff 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  text-shadow:0 0 60px rgba(31,209,255,.35);
  animation:titleRise 1.1s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes titleRise{from{opacity:0;transform:translateY(24px) scale(.97);letter-spacing:.15em;}to{opacity:1;transform:translateY(0) scale(1);letter-spacing:.06em;}}
.game-subtitle{
  font-size:clamp(13px,2vw,17px);
  color:var(--ink-dim);
  letter-spacing:.05em;
  font-weight:500;
  animation:fadeIn 1.4s ease .3s both;
}
.landing-buttons{display:flex;flex-direction:column;gap:12px;margin-top:18px;width:min(320px,80vw);animation:fadeIn 1.6s ease .5s both;}
.eyebrow{
  font-family:var(--font-display);letter-spacing:.35em;font-size:11px;color:var(--turquoise);
  text-transform:uppercase;animation:fadeIn 1s ease 0s both;
}
.landing-topbar{position:absolute;top:22px;right:26px;z-index:3;display:flex;gap:10px;}

/* ================= MODAL BASE ================= */
.modal-overlay{
  position:fixed;inset:0;z-index:50;
  background:rgba(2,6,12,.65);
  backdrop-filter:blur(4px);
  display:none;align-items:center;justify-content:center;
  padding:20px;
  animation:fadeIn .25s ease;
}
.modal-overlay.active{display:flex;}
.modal-box{
  width:100%;max-width:560px;max-height:88vh;overflow:auto;
  background:linear-gradient(180deg, rgba(15,44,71,.92), rgba(8,22,38,.96));
  border:1px solid var(--glass-border);
  border-radius:20px;padding:28px;
  box-shadow:0 30px 80px rgba(0,0,0,.55);
  animation:modalPop .3s cubic-bezier(.2,.9,.25,1.1);
}
.modal-box.wide{max-width:880px;}
@keyframes modalPop{from{opacity:0;transform:scale(.94) translateY(10px);}to{opacity:1;transform:scale(1) translateY(0);}}
.modal-title{font-family:var(--font-display);font-size:24px;font-weight:700;letter-spacing:.03em;margin-bottom:4px;}
.modal-sub{color:var(--ink-dim);font-size:13px;margin-bottom:18px;}
.modal-close{position:absolute;}
.close-x{position:absolute;top:18px;right:18px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.06);border:1px solid var(--glass-border);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;}
.close-x:hover{background:rgba(255,255,255,.14);}

/* ================= PROFILE SETUP ================= */
#screen-profile{justify-content:center;align-items:center;background:radial-gradient(ellipse at 50% 0%, #0e2c46 0%, var(--navy-deep) 70%);}
.profile-card{width:min(460px,92vw);padding:34px;text-align:center;}
.profile-card input{
  width:100%;padding:14px 16px;border-radius:10px;border:1px solid var(--glass-border);
  background:rgba(255,255,255,.04);color:var(--ink);font-size:16px;font-family:var(--font-body);
  margin:18px 0 22px;outline:none;transition:border-color .2s;
}
.profile-card input:focus{border-color:var(--cyan);}
.avatar-row{display:flex;gap:12px;justify-content:center;margin-bottom:6px;}
.avatar-opt{width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;background:rgba(255,255,255,.05);border:2px solid transparent;cursor:pointer;transition:all .2s;}
.avatar-opt.selected{border-color:var(--cyan);background:rgba(31,209,255,.15);transform:scale(1.08);}

/* ================= GAME SCREEN ================= */
#screen-game{background:var(--navy-deep);}
#game-canvas-wrap{position:absolute;inset:0;}
#ocean-canvas{width:100%;height:100%;display:block;}

.hud-top{
  position:absolute;top:0;left:0;right:0;z-index:5;
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 18px;gap:12px;
  pointer-events:none;
}
.hud-top>*{pointer-events:auto;}
.hud-stats{display:flex;gap:10px;flex-wrap:wrap;}
.stat-chip{
  display:flex;align-items:center;gap:8px;padding:9px 14px;
  min-width:98px;
}
.stat-chip .val{font-family:var(--font-display);font-weight:700;font-size:16px;}
.stat-chip .lbl{font-size:9px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.08em;}
.stat-icon{font-size:18px;}
.bar-track{width:56px;height:5px;border-radius:4px;background:rgba(255,255,255,.12);overflow:hidden;margin-top:3px;}
.bar-fill{height:100%;border-radius:4px;transition:width .4s ease;}
#fuel-fill{background:linear-gradient(90deg,#2ee6a6,#1fd1ff);}
#fuel-fill.low{background:linear-gradient(90deg,#ffb238,#ff4d5e);}
#health-fill{background:linear-gradient(90deg,#2ee6a6,#7be07a);}

.hud-topright{display:flex;gap:8px;}

.hud-left{
  position:absolute;left:14px;top:96px;z-index:5;
  display:flex;flex-direction:column;gap:8px;
}
.layer-btn{
  width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;
  font-size:19px;cursor:pointer;background:var(--glass-bg);border:1px solid var(--glass-border);
  transition:all .2s;position:relative;
}
.layer-btn.active{border-color:var(--pfz-green);box-shadow:0 0 14px rgba(46,230,166,.4);background:rgba(46,230,166,.12);}
.layer-btn:hover{transform:translateX(3px);}

.hud-info-panel{
  position:absolute;right:14px;top:96px;z-index:5;
  width:230px;padding:16px;
  display:flex;flex-direction:column;gap:10px;
}
.info-row{display:flex;justify-content:space-between;align-items:center;font-size:12px;}
.info-row .k{color:var(--ink-dim);display:flex;align-items:center;gap:6px;}
.info-row .v{font-family:var(--font-display);font-weight:700;font-size:14px;}
.info-divider{height:1px;background:var(--glass-border);margin:2px 0;}
.zone-badge{
  display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.04em;
}

.hud-bottom{
  position:absolute;bottom:0;left:0;right:0;z-index:6;
  display:flex;align-items:center;justify-content:center;gap:12px;
  padding:16px;
}
.dock-btn{
  display:flex;flex-direction:column;align-items:center;gap:4px;
  padding:11px 18px;min-width:74px;
  cursor:pointer;transition:all .2s;
}
.dock-btn .di{font-size:22px;}
.dock-btn .dl{font-size:9.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-dim);font-weight:600;}
.dock-btn:hover{transform:translateY(-4px);border-color:var(--cyan);}
.dock-btn.active{border-color:var(--turquoise);background:rgba(46,196,182,.18);}
.dock-btn:disabled{opacity:.3;pointer-events:none;}

.mission-tracker{
  position:absolute;left:14px;bottom:96px;z-index:5;width:250px;padding:14px 16px;
}
.mission-tracker .mt-title{font-family:var(--font-display);font-weight:700;font-size:13px;color:var(--turquoise);letter-spacing:.03em;margin-bottom:6px;display:flex;justify-content:space-between;}
.mt-obj{font-size:11.5px;color:var(--ink-dim);display:flex;gap:6px;align-items:flex-start;margin-top:4px;line-height:1.4;}
.mt-obj.done{color:var(--pfz-green);text-decoration:line-through;opacity:.7;}

.toast-stack{position:absolute;top:96px;left:50%;transform:translateX(-50%);z-index:20;display:flex;flex-direction:column;gap:8px;align-items:center;width:min(420px,92vw);}
.toast{
  padding:12px 18px;border-radius:12px;font-size:13px;font-weight:600;
  display:flex;align-items:center;gap:10px;animation:toastIn .35s ease;width:100%;
}
@keyframes toastIn{from{opacity:0;transform:translateY(-14px);}to{opacity:1;transform:translateY(0);}}
.toast.warn{border-left:4px solid var(--amber);}
.toast.danger{border-left:4px solid var(--danger);}
.toast.good{border-left:4px solid var(--pfz-green);}
.toast.info{border-left:4px solid var(--cyan);}

/* ================= SONAR ================= */
.sonar-wrap{display:flex;flex-direction:column;align-items:center;gap:14px;}
#sonar-canvas{border-radius:50%;background:radial-gradient(circle at 50% 50%, #04141f 0%, #01080d 100%);box-shadow:0 0 0 3px rgba(31,209,255,.25), 0 0 40px rgba(31,209,255,.15) inset;}
.sonar-readout{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;}
.sonar-readout .sr-item{text-align:center;}
.sonar-readout .sr-val{font-family:var(--font-display);font-weight:700;font-size:18px;color:var(--cyan);}
.sonar-readout .sr-lbl{font-size:10px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.06em;}

/* ================= FISHING MINIGAME ================= */
.fish-wrap{display:flex;flex-direction:column;align-items:center;gap:16px;}
.fish-info{display:flex;align-items:center;gap:12px;}
.fish-emoji{font-size:38px;}
.tension-bar{
  position:relative;width:100%;max-width:420px;height:34px;border-radius:20px;
  background:rgba(255,255,255,.06);border:1px solid var(--glass-border);overflow:hidden;
}
.tension-zone{position:absolute;top:0;bottom:0;background:rgba(46,230,166,.28);border-left:2px solid var(--pfz-green);border-right:2px solid var(--pfz-green);}
.tension-marker{position:absolute;top:-4px;width:6px;height:42px;background:var(--cyan);border-radius:4px;box-shadow:0 0 10px var(--cyan);transition:left .02s linear;}
.progress-bar{width:100%;max-width:420px;height:16px;border-radius:10px;background:rgba(255,255,255,.06);overflow:hidden;border:1px solid var(--glass-border);}
.progress-fill{height:100%;background:linear-gradient(90deg,#2ee6a6,#1fd1ff);width:0%;transition:width .1s linear;}
.reel-btn{
  width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%, #26e0c9, #0a7d78);
  border:4px solid rgba(255,255,255,.2);
  font-family:var(--font-display);font-weight:700;font-size:16px;color:#04201d;
  cursor:pointer;box-shadow:0 10px 30px rgba(38,224,201,.4);
  transition:transform .1s;
  touch-action:none;
}
.reel-btn:active{transform:scale(.94);}
.line-health-track{width:100%;max-width:420px;height:8px;border-radius:6px;background:rgba(255,255,255,.06);overflow:hidden;}
.line-health-fill{height:100%;background:linear-gradient(90deg,#ffd93d,#ff9f43);width:100%;transition:width .1s linear;}

/* ================= TRIP SUMMARY ================= */
.score-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px dashed var(--glass-border);font-size:14px;}
.score-row .sr-label{display:flex;align-items:center;gap:8px;color:var(--ink-dim);}
.score-row .sr-num{font-family:var(--font-display);font-weight:700;font-size:16px;color:var(--cyan);}
.score-total{display:flex;justify-content:space-between;align-items:center;padding:16px 0 4px;font-family:var(--font-display);font-size:22px;font-weight:700;}
.tip-box{
  margin-top:14px;padding:14px 16px;border-radius:12px;background:rgba(255,178,56,.08);
  border:1px solid rgba(255,178,56,.3);font-size:12.5px;line-height:1.5;color:#ffdca6;
}
.tip-box.good{background:rgba(46,230,166,.08);border-color:rgba(46,230,166,.3);color:#bdf5e0;}

/* ================= GARAGE ================= */
.garage-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px;}
.stat-block{padding:12px 14px;}
.stat-block .sb-lbl{font-size:10px;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;}
.stat-block .sb-bar{height:6px;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden;}
.stat-block .sb-fill{height:100%;background:linear-gradient(90deg,#1fd1ff,#2ee6a6);}
.upgrade-item{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;margin-top:10px;}
.upgrade-item .ui-left{display:flex;gap:10px;align-items:center;}
.upgrade-item .ui-name{font-weight:700;font-size:13.5px;}
.upgrade-item .ui-desc{font-size:11px;color:var(--ink-dim);}

/* ================= KNOWLEDGE ================= */
.know-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-top:14px;}
.know-card{
  perspective:1000px;height:150px;cursor:pointer;
}
.know-card-inner{position:relative;width:100%;height:100%;transition:transform .6s cubic-bezier(.2,.8,.2,1);transform-style:preserve-3d;}
.know-card.flipped .know-card-inner{transform:rotateY(180deg);}
.know-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:14px;padding:14px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:6px;background:var(--glass-bg);border:1px solid var(--glass-border);}
.know-face.back{transform:rotateY(180deg);font-size:11.5px;line-height:1.4;color:var(--ink-dim);background:linear-gradient(160deg, rgba(31,209,255,.12), rgba(46,196,182,.08));}
.know-emoji{font-size:30px;}

/* ================= LEADERBOARD ================= */
.lb-tabs{display:flex;gap:8px;margin-bottom:14px;}
.lb-tab{padding:7px 14px;border-radius:8px;font-size:12px;cursor:pointer;background:rgba(255,255,255,.04);border:1px solid transparent;}
.lb-tab.active{background:rgba(31,209,255,.15);border-color:var(--cyan);}
.lb-row{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;margin-bottom:6px;}
.lb-row.me{background:rgba(46,230,166,.1);border:1px solid rgba(46,230,166,.35);}
.lb-rank{font-family:var(--font-display);font-weight:700;width:28px;text-align:center;}
.lb-name{flex:1;font-weight:600;font-size:13px;}
.lb-score{font-family:var(--font-display);font-weight:700;color:var(--cyan);}

/* ================= MISSION SELECT ================= */
.mission-grid{display:flex;flex-direction:column;gap:10px;margin-top:14px;max-height:56vh;overflow:auto;}
.mission-item{display:flex;align-items:center;gap:14px;padding:14px;cursor:pointer;transition:all .2s;}
.mission-item:hover{border-color:var(--cyan);}
.mission-item.locked{opacity:.45;cursor:not-allowed;}
.mission-num{font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--turquoise);width:38px;}
.mission-item .mi-title{font-weight:700;font-size:14px;}
.mission-item .mi-desc{font-size:11.5px;color:var(--ink-dim);}

/* ================= SETTINGS ================= */
.settings-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--glass-border);}
.toggle{width:48px;height:26px;border-radius:20px;background:rgba(255,255,255,.1);position:relative;cursor:pointer;transition:background .2s;}
.toggle.on{background:var(--turquoise);}
.toggle .knob{position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .2s;}
.toggle.on .knob{left:25px;}

/* ================= WEATHER ALERT ================= */
.alert-icon{font-size:44px;text-align:center;margin-bottom:6px;}

/* Level up */
.levelup-badge{width:110px;height:110px;border-radius:50%;margin:0 auto 14px;background:radial-gradient(circle at 35% 30%, #ffe27a,#ff9f43);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:34px;font-weight:700;color:#3a1c00;box-shadow:0 0 60px rgba(255,178,56,.5);animation:levelPop .6s cubic-bezier(.3,1.4,.4,1);}
@keyframes levelPop{from{transform:scale(0) rotate(-30deg);}to{transform:scale(1) rotate(0);}}

/* Loading */
#boot-loader{position:fixed;inset:0;z-index:100;background:var(--navy-deep);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;}
.loader-ring{width:52px;height:52px;border-radius:50%;border:3px solid rgba(31,209,255,.2);border-top-color:var(--cyan);animation:spin 1s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ---------- Mobile ---------- */
@media (max-width:720px){
  .hud-left{top:auto;bottom:150px;left:8px;flex-direction:row;flex-wrap:wrap;width:150px;}
  .hud-info-panel{width:150px;top:70px;right:8px;padding:10px;font-size:11px;}
  .mission-tracker{width:150px;left:8px;bottom:150px;display:none;}
  .hud-bottom{gap:6px;padding:10px 6px;overflow-x:auto;justify-content:flex-start;}
  .dock-btn{min-width:60px;padding:8px 10px;}
  .stat-chip{min-width:74px;padding:7px 10px;}
  .stat-chip .val{font-size:13px;}
  .game-title{font-size:clamp(38px,13vw,64px);}
  .modal-box{padding:20px;}
}
