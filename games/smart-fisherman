/* ---- Trip ending & scoring ---- */
function checkPortReturn(){
  if(!Trip.active) return;
  const d=distFrac(Trip.boatX,Trip.boatY,PORT.x,PORT.y);
  if(d<0.03 && Trip.targetX===null && (Trip.cargo.length>0 || Trip.distanceTraveled>0.05)){
    // only auto-complete if user actually intended to return: check if last command was return, simplify: complete whenever near port after having left
    if(Trip._leftPort){ endTrip(true); }
  } else if(d>0.05){ Trip._leftPort=true; }
}

function endTrip(reachedPort){
  if(!Trip.active) return;
  Trip.active=false;
  const boat=currentBoat();
  const fuelPctRemaining=clamp(Trip.fuel,0,100*(boat.fuelCap/100))/(boat.fuelCap/100);
  const mission=Trip.mission;

  const catchScore=Trip.scoreCatch;
  const navScore = Math.round(clamp(150 - Trip.distanceTraveled*80,20,150) + (Trip.storyFlags.enteredHighQuality?0:0));
  const awarenessScore = Trip.scoreAwareness || (Trip.layersChecked.size*40);
  const fuelEffScore = Math.round(clamp(fuelPctRemaining,0,100));
  const safetyScore = Math.round(Trip.scoreSafety);
  const total = catchScore+navScore+awarenessScore+fuelEffScore+safetyScore;

  const missionSuccess = reachedPort && Trip.cargo.length>=mission.targetCatch && fuelPctRemaining>0;

  Profile.totalCatches += Trip.cargo.length;
  Profile.totalEarnings += Trip.earnings;
  if(missionSuccess){ Profile.successfulTrips++; if(!Profile.missionsCompleted.includes(mission.id)) Profile.missionsCompleted.push(mission.id); }
  Profile.safetyRating = clamp(Math.round((Profile.safetyRating + (safetyScore/300*100))/2),0,100);

  const xpGain = Math.round(total*0.4) + (missionSuccess?150:20);
  Profile.xp += xpGain;
  let leveledUp=false;
  while(Profile.xp >= xpForLevel(Profile.level)){
    Profile.xp -= xpForLevel(Profile.level);
    Profile.level++; leveledUp=true;
  }
  saveProfile();
  saveLeaderboardEntry(total);

  showTripSummary({catchScore,navScore,awarenessScore,fuelEffScore,safetyScore,total,xpGain,missionSuccess,reachedPort,fuelPctRemaining});
  if(leveledUp) setTimeout(()=>showLevelUp(),600);
}

function showTripSummary(s){
  $('#summary-eyebrow').textContent = s.missionSuccess? 'MISSION COMPLETE':'TRIP COMPLETE';
  $('#summary-title').textContent = s.missionSuccess? 'Well Sailed!':'Trip Summary';
  const rows=[
    ['🎣 Catch',s.catchScore],['🧭 Navigation',s.navScore],['🌊 Ocean Awareness',s.awarenessScore],
    ['⛽ Fuel Efficiency',s.fuelEffScore],['🛟 Safety',s.safetyScore],
  ];
  $('#summary-rows').innerHTML=rows.map(r=>`<div class="score-row"><span class="sr-label">${r[0]}</span><span class="sr-num">+${r[1]}</span></div>`).join('')
    + `<div class="score-row"><span class="sr-label">💰 Profit</span><span class="sr-num">₹${fmt(Trip.earnings)}</span></div>
       <div class="score-row"><span class="sr-label">✨ XP Gained</span><span class="sr-num">+${s.xpGain}</span></div>`;
  animateCount($('#summary-total'),0,s.total,900);
  let tip='';
  if(!s.reachedPort) tip='⚠️ SMART DECISION TIP — Your trip ended before returning to port. Always plan enough fuel and time to return safely, even if it means leaving a good zone early.';
  else if(s.fuelEffScore<25) tip='⚠️ SMART DECISION TIP — You returned with very little fuel. Choosing a closer PFZ with slightly lower quality is often the safer, more profitable choice.';
  else if(s.safetyScore<150) tip='⚠️ SMART DECISION TIP — You took on real risk from rough conditions. Watching the Wave and Hazard layers earlier would have reduced the danger.';
  else if(s.missionSuccess) tip='✅ Great decisions — you balanced fishing zone quality, fuel and safety like a true smart fisherman.';
  else tip='Keep exploring the ocean layers before choosing a zone — the highest-probability PFZ isn\'t always the closest one.';
  const tipBox=$('#summary-tip'); tipBox.textContent=tip; tipBox.className='tip-box'+(tip.startsWith('✅')?' good':'');
  openModal('modal-trip-summary');
}
function animateCount(el,from,to,ms){
  const t0=performance.now();
  function step(t){
    const p=clamp((t-t0)/ms,0,1);
    el.textContent=fmt(lerp(from,to,1-Math.pow(1-p,3)));
    if(p<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
