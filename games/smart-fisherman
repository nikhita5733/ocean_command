  const zoneLeft = 50-zoneWpx/2;
  $('#tension-zone').style.left=zoneLeft+'%'; $('#tension-zone').style.width=zoneWpx+'%';
  $('#fish-progress').style.width='0%'; $('#line-health').style.width='100%';
  fishGame={fish,zone,pos:0,dir:1,progress:0,lineHealth:100,holding:false,zoneLeft,zoneWpx,active:true};
