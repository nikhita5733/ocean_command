/* ---------------- Landing background canvas ---------------- */
const lc=document.getElementById('landing-canvas'); const lctx=lc.getContext('2d');
let LW=0,LH=0,lt=0;
function resizeLanding(){ LW=lc.clientWidth; LH=lc.clientHeight; lc.width=LW*devicePixelRatio; lc.height=LH*devicePixelRatio; lctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0); }
window.addEventListener('resize',resizeLanding);
function drawLanding(dt){
  lt+=dt;
  const g=lctx.createLinearGradient(0,0,0,LH);
  g.addColorStop(0,'#ffb37a'); g.addColorStop(0.28,'#2c6e8f'); g.addColorStop(0.5,'#0c3d59'); g.addColorStop(1,'#031522');
  lctx.fillStyle=g; lctx.fillRect(0,0,LW,LH);
  // sun
  lctx.save(); lctx.globalAlpha=0.85; const sg=lctx.createRadialGradient(LW*0.5,LH*0.32,0,LW*0.5,LH*0.32,140);
  sg.addColorStop(0,'rgba(255,230,180,0.9)'); sg.addColorStop(1,'rgba(255,230,180,0)');
  lctx.fillStyle=sg; lctx.beginPath(); lctx.arc(LW*0.5,LH*0.32,140,0,7); lctx.fill(); lctx.restore();
  // clouds
  for(let i=0;i<4;i++){
    const cx=(LW*(0.15+i*0.25)+Math.sin(lt*0.03+i)*20)%(LW+200)-100, cy=LH*(0.15+i*0.05);
    lctx.save(); lctx.globalAlpha=0.18; lctx.fillStyle='#fff';
    for(let k=0;k<4;k++){ lctx.beginPath(); lctx.ellipse(cx+k*26,cy,30,16,0,0,7); lctx.fill(); }
    lctx.restore();
  }
  // waves
  for(let i=0;i<8;i++){
    lctx.beginPath();
    const yBase=LH*(0.42+i*0.075);
    for(let x=0;x<=LW;x+=16){
      const y=yBase+Math.sin(x*0.018+lt*0.7+i)*(4+i*1.2);
      x===0?lctx.moveTo(x,y):lctx.lineTo(x,y);
    }
    lctx.lineTo(LW,LH); lctx.lineTo(0,LH); lctx.closePath();
    lctx.fillStyle=`rgba(4,${20+i*4},${40+i*6},0.35)`;
    lctx.fill();
  }
  // boat silhouette
  const bx=LW*0.68, by=LH*0.5+Math.sin(lt*1.4)*4;
  lctx.save(); lctx.translate(bx,by); lctx.fillStyle='rgba(6,16,26,0.85)';
  lctx.beginPath(); lctx.moveTo(-34,0); lctx.lineTo(34,0); lctx.lineTo(24,14); lctx.lineTo(-24,14); lctx.closePath(); lctx.fill();
  lctx.beginPath(); lctx.moveTo(0,0); lctx.lineTo(0,-30); lctx.lineTo(16,0); lctx.closePath(); lctx.fill();
  lctx.restore();
  // birds
  for(let i=0;i<3;i++){
    const bx2=(LW*0.1+ (lt*18+i*140)%(LW+120))-60, by2=LH*(0.18+i*0.05);
    lctx.save(); lctx.strokeStyle='rgba(20,20,20,0.5)'; lctx.lineWidth=2;
    const flap=Math.sin(lt*6+i)*6;
    lctx.beginPath(); lctx.moveTo(bx2-8,by2+flap); lctx.quadraticCurveTo(bx2,by2-6,bx2+8,by2+flap); lctx.stroke();
    lctx.restore();
  }
}
let lastLandT=performance.now();
function landingLoop(t){
  const dt=Math.min((t-lastLandT)/1000,0.05); lastLandT=t;
  if($('#screen-landing').classList.contains('active')){
    if(LW!==lc.clientWidth||LH!==lc.clientHeight) resizeLanding();
    drawLanding(dt);
  }
  requestAnimationFrame(landingLoop);
}

/* ---------------- Boot ---------------- */
(async function boot(){
  resizeLanding(); resizeCanvas();
  await loadProfile();
  const saved=await Store.load('myScores'); if(saved) myScores=saved;
  requestAnimationFrame(landingLoop);
  requestAnimationFrame(mainLoop);
  setTimeout(()=>{ document.getElementById('boot-loader').style.display='none'; },500);
})();

</script>
