let fishRAF=null;
function fishLoop(){
  let last=performance.now();
  function loop(t){
    if(!fishGame||!fishGame.active) return;
    const dt=Math.min((t-last)/1000,0.05); last=t;
    const g=fishGame; const speed=fish_speed(g.fish);
    g.pos += g.dir*speed*dt;
    if(g.pos>1){g.pos=1;g.dir=-1;} if(g.pos<0){g.pos=0;g.dir=1;}
    const posPct=g.pos*100;
    $('#tension-marker').style.left=`calc(${posPct}% - 3px)`;
    const inZone = posPct>=g.zoneLeft && posPct<=g.zoneLeft+g.zoneWpx;
    if(g.holding){
      if(inZone){ g.progress=clamp(g.progress+dt*32,0,100); if(Math.random()<0.15) Audio1.reel(); }
      else { g.lineHealth=clamp(g.lineHealth-dt*40,0,100); }
    } else {
      g.progress=clamp(g.progress-dt*6,0,100);
    }
    $('#fish-progress').style.width=g.progress+'%';
    $('#line-health').style.width=g.lineHealth+'%';
    if(g.progress>=100){ finishFishing(true); return; }
    if(g.lineHealth<=0){ finishFishing(false); return; }
    fishRAF=requestAnimationFrame(loop);
  }
  fishRAF=requestAnimationFrame(loop);
}
function fish_speed(fish){ return fish.speed*0.55; }
function finishFishing(success){
  fishGame.active=false;
  if(fishRAF) cancelAnimationFrame(fishRAF);
  setTimeout(()=>{
    closeModal('modal-fishing');
    if(success){
      Audio1.success();
      const fish=fishGame.fish, zone=fishGame.zone;
      Trip.cargo.push({fish:fish.id,value:fish.value,zoneQuality:zone.quality});
      Trip.earnings+=fish.value;
      Trip.scoreCatch += Math.round(fish.value*0.9);
      if(zone.quality>=4){ Trip.storyFlags.enteredHighQuality=true; }
      toast(`Caught a ${fish.name}! +₹${fish.value}`,'good',2800);
    } else {
      Audio1.fail();
      toast('The line snapped — fish got away.','danger',2600);
    }
    updateMissionTracker();
    fishGame=null;
  },350);
}

